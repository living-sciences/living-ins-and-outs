Notebook[{
Cell[BoxData[{
    \(\(<< Graphics`MultipleListPlot`;\)\), "\[IndentingNewLine]", 
    \(\(<< 
        Statistics`MultiDescriptiveStatistics`;\)\), "\[IndentingNewLine]", 
    \(\(<< Statistics`LinearRegression`;\)\), "\[IndentingNewLine]", 
    \(\(Off[General::spell1];\)\), "\[IndentingNewLine]", 
    \(\(Off[General::spell];\)\)}], "Input"],

Cell[CellGroupData[{

Cell["Define the HP Filter", "Subsubsection"],

Cell[BoxData[{
    \(\(\(Trend[vec_, smooth_] := 
        Module[{T, A, B}, 
          T = Length[vec]; \[IndentingNewLine]A = 
            Append[Append[
                Prepend[
                  Prepend[
                    Table[PadRight[
                        PadLeft[{\(-1\), 4, \(-6\), 4, \(-1\)}, t + 2], 
                        T], {t, 3, T - 2}], 
                    PadRight[{2, \(-5\), 4, \(-1\)}, T]], 
                  PadRight[{\(-1\), 2, \(-1\)}, T]], 
                PadLeft[{\(-1\), 4, \(-5\), 2}, T]], 
              PadLeft[{\(-1\), 2, \(-1\)}, T]]; \[IndentingNewLine]B = 
            Inverse[IdentityMatrix[T] - N[smooth]\ A]; \[IndentingNewLine]Exp[
            B . Log[N[vec]]]];\)\(\n\)
    \)\), "\[IndentingNewLine]", 
    \(\(Detrend[vec_, smooth_] := 
        Log[vec] - Log[Trend[vec, smooth]];\)\)}], "Input"],

Cell[BoxData[
    \(\(SetDirectory["\<C:\FindSep\>"];\)\)], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Set the HP Filter parameter to my preferred high value.", \
"Subsubsection"],

Cell[BoxData[
    \(\(smooth\  = \ 10\^5;\)\)], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Set the start year.", "Subsubsection"],

Cell[BoxData[
    \(\(start = 1951;\)\)], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Import monthly data on Unemployment, Employment, Short-term Employment, and \
Help-Wanted Advertisements.  Adjust  the Short-Term Unemployment Rate Data to \
Account for the CPS Redesign.\
\>", "Subsubsection"],

Cell["\<\
The first 517 elements of the short-term unemployment rate series are fine.  \
On and after February 1994, the data are messed up by the January 1994 CPS \
Redesign.   See Appendix A in  \"Reassessing the Ins and Outs of \
Unemployment,\" January 28, 2005 version.  I correct this using the CPS \
microdata.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(UnempM = Import["\<unemp.txt\>", "\<Lines\>"];\)\), "\n", 
    \(\(Print[UnempM\[LeftDoubleBracket]1\[RightDoubleBracket]];\)\), "\n", 
    \(\(\(UnempM = ToExpression @@ {Drop[UnempM, 1]};\)\(\n\)
    \)\), "\[IndentingNewLine]", 
    \(\(EmpM = Import["\<emp.txt\>", "\<Lines\>"];\)\), "\n", 
    \(\(Print[EmpM\[LeftDoubleBracket]1\[RightDoubleBracket]];\)\), "\n", 
    \(\(\(EmpM = ToExpression @@ {Drop[EmpM, 1]};\)\(\n\)
    \)\), "\[IndentingNewLine]", 
    \(\(ShortM = Import["\<short.txt\>", "\<Lines\>"];\)\), "\n", 
    \(\(Print[ShortM\[LeftDoubleBracket]1\[RightDoubleBracket]];\)\), "\n", 
    \(\(\(ShortM = ToExpression @@ {Drop[ShortM, 1]};\)\(\n\)
    \)\), "\[IndentingNewLine]", 
    \(\(HelpM = Import["\<helpwant.txt\>", "\<Lines\>"];\)\), "\n", 
    \(\(Print[HelpM\[LeftDoubleBracket]1\[RightDoubleBracket]];\)\), "\n", 
    \(\(\(HelpM = ToExpression @@ {Drop[HelpM, 1]};\)\(\n\)
    \)\), "\[IndentingNewLine]", 
    \(\(ShortShareM = Import["\<shortadj.txt\>", "\<Lines\>"];\)\), "\n", 
    \(Print[ShortShareM\[LeftDoubleBracket]1\[RightDoubleBracket]]; 
    ShortShareM = 
      ToExpression @@ {Drop[ShortShareM, 1]};\), "\[IndentingNewLine]", 
    \(\(ShortAdjM = 
        ShortShareM*
          Take[UnempM, {12 \((1976 - start)\) + 1, 
              12 \((1976 - start)\) + Length[ShortShareM]}];\)\), "\n", 
    \(\(ShortAdjM = 
        Flatten[Prepend[ShortAdjM, 
            Take[ShortM, 12 \((1976 - start)\)]]];\)\)}], "Input"],

Cell[BoxData[
    \("LNS13000000, Seas Adj Unmployment Level (Thousands), 16 years and \
over, 1951:M1--2005:M4, Downloaded May 14, 2005"\)], "Print"],

Cell[BoxData[
    \("LNS12000000, Seas Adj Employment Level (Thousands), 16 years and over, \
1951:M1--2005:M4, Downloaded May 14, 2005"\)], "Print"],

Cell[BoxData[
    \("LNS13008396, Seas Adj Unemployed for Less than 5 Weeks (Thousands), 16 \
years and over, 1951:M1--2005:M4, Downloaded May 14, 2005"\)], "Print"],

Cell[BoxData[
    \("Index of Help Wanted Advertising in Newspapers, The Conference Board, \
1987=100, 1951:M1 to 2005:M3 Last Updated: 2005-04-28 10:06 AM CT"\)], "Print"],

Cell[BoxData[
    \("Fraction of Unemployed with Duration <= 4 weeks, Sample: Age >= 16, \
MIS = 1 or 5.  Computed from CPS Microdata and seasonally adjusted using the \
Census X-12 Algorithm, 1976:M1--2005:M1"\)], "Print"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Figure out the longest available data series and print the stopping date.\
\>", "Subsubsection"],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(available\  = 
        Min[{Length[UnempM], Length[EmpM], Length[HelpM], 
            Length[ShortAdjM]}];\)\), "\n", 
    \(UnempM = Take[UnempM, available]; EmpM = Take[EmpM, available]; 
    HelpM = Take[HelpM, available]; 
    ShortAdjM = Take[ShortAdjM, available];\), "\n", 
    \(\(Print[IntegerPart[start + available\/12], "\<:M\>", 
        available - 12  IntegerPart[available\/12]];\)\), "\n", 
    \(dateM[x_] := 
      Transpose[{Table[start + \(i - 1\)\/12. , {i, 1, Length[x]}], x}]; 
    dateQ[x_] := 
      Transpose[{Table[start + \(i - 1\)\/4. , {i, 1, Length[x]}], 
          x}];\)}], "Input"],

Cell[BoxData[
    InterpretationBox[\(2005\[InvisibleSpace]":M"\[InvisibleSpace]1\),
      SequenceForm[ 2005, ":M", 1],
      Editable->False]], "Print"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Construct the unemployment rate, led by one period.", "Subsubsection"],

Cell[BoxData[
    \(\(UrateM = Drop[UnempM\/\(UnempM + EmpM\), 1];\)\)], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Plot the Adjustment to the Short Term Unemployment Rate time series.\
\>", "Subsubsection"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(MultipleListPlot[dateM[ShortAdjM], dateM[ShortM], 
        PlotJoined \[Rule] True, PlotStyle \[Rule] {Hue[0], Hue[2/3]}, 
        PlotLegend \[Rule] {"\<Adjusted\>", "\<Published Data\>"}, 
        PlotLabel \[Rule] "\<Short Term Unemployment\>", 
        SymbolShape \[Rule] None];\)\)], "Input"],

Cell[GraphicsData["PostScript", "\<\
