Cell[CellGroupData[{

Cell["\<\
Construct the Job Finding Probability F according to \"Reassessing the Ins \
and Outs of Unemployment,\" January 28, 2005 version, Equation (4).\
\>", "Subsubsection"],

Cell[BoxData[{
    \(\(FindM = 
        1.  - \(Drop[UnempM, 1] - Drop[ShortAdjM, 1]\)\/Drop[UnempM, \(-1\)];\
\)\), "\n", 
    \(\(findM = \(-Log[1 - FindM]\);\)\)}], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Construct\ the\ Separation\ Rate\ s\ according\ to\ Equation\ 5. \)], \
"Subsubsection"],

Cell[BoxData[{
    \(t = 1; sepM = {}; 
    While[t < Length[UnempM], 
      sepM = Append[sepM, 
          s /. \[InvisibleSpace]FindRoot[
              UnempM\[LeftDoubleBracket]t + 
                    1\[RightDoubleBracket] \[Equal] \(\((1 - \
\[ExponentialE]\^\(\(-findM\[LeftDoubleBracket]t\[RightDoubleBracket]\) - \
s\))\)\ s\ \((UnempM\[LeftDoubleBracket]t\[RightDoubleBracket] + EmpM\
\[LeftDoubleBracket]t\[RightDoubleBracket])\)\)\/\(findM\[LeftDoubleBracket]t\
\[RightDoubleBracket] + s\) + \
\[ExponentialE]\^\(\(-findM\[LeftDoubleBracket]t\[RightDoubleBracket]\) - s\)\
\ UnempM\[LeftDoubleBracket]t\[RightDoubleBracket], {s, 0.03}]]; 
      t += 1];\n\), "\n", 
    \(\(SepM = 1 - \[ExponentialE]\^\(-sepM\);\)\)}], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compute Quarterly Averages", "Subsubsection"],

Cell[BoxData[{
    \(\(findQ = 
        1\/3\ Plus @@ 
            Transpose[Partition[findM, 3]];\)\), "\[IndentingNewLine]", 
    \(\(UrateQ = \(1\/3\) 
          Plus @@ Transpose[
              Partition[UrateM, 3]];\)\), "\[IndentingNewLine]", 
    \(\(sepQ = 
        1\/3\ Plus @@ 
            Transpose[Partition[sepM, 3]];\)\), "\[IndentingNewLine]", 
    \(\(HelpQ = 
        Plus @@ Transpose[Partition[HelpM, 3]];\)\), "\[IndentingNewLine]", 
    \(\(UnempQ = Plus @@ Transpose[Partition[UnempM, 3]];\)\)}], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Export\ Data\ for\ LaTeX\)], "Subsubsection"],

Cell[BoxData[{
    \(\(Export["\<find.dat\>", dateQ[findQ]];\)\), "\[IndentingNewLine]", 
    \(\(Export["\<urate.dat\>", 
        dateQ[N[UrateQ]]];\)\), "\[IndentingNewLine]", 
    \(\(Export["\<sep.dat\>", dateQ[sepQ]];\)\), "\[IndentingNewLine]", 
    \(\(Export["\<theta.dat\>", 
        dateQ[N[\(100  HelpQ\)\/UnempQ]]];\)\), "\[IndentingNewLine]", 
    \(\(Export["\<uss.dat\>", 
        dateQ[N[sepQ\/\(sepQ + findQ\)]]];\)\), "\[IndentingNewLine]", 
    \(\(Export["\<uf.dat\>", 
        dateQ[N[Mean[sepQ]\/\(Mean[sepQ] + findQ\)]]];\)\), "\
\[IndentingNewLine]", 
    \(\(Export["\<us.dat\>", 
        dateQ[N[sepQ\/\(sepQ + Mean[findQ]\)]]];\)\)}], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Print the Correlation between the job finding and unemployment rates and \
between the separation and unemployment rates.\
\>", "Subsubsection"],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(Print[
        Correlation[Detrend[findQ, smooth], 
          Detrend[UrateQ, smooth]]];\)\), "\n", 
    \(\(Print[
        Correlation[Detrend[sepQ, smooth], 
          Detrend[UrateQ, smooth]]];\)\), "\n", 
    \(\(Print[
        Correlation[Detrend[findQ, smooth], 
          Detrend[HelpQ\/UnempQ, smooth]]];\)\)}], "Input"],

Cell[BoxData[
    \(\(-0.96522682969764`\)\)], "Print"],

Cell[BoxData[
    \(0.6492817924646983`\)], "Print"],

Cell[BoxData[
    \(0.9612087820137091`\)], "Print"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Print the output of a regression of \"Hypothetical\" unemployment rates (only \
changes in f or only changes in s) on the actual unemployment rate.\
\>", "Subsubsection"],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(Print[
        Regress[Transpose[{Detrend[UrateQ, smooth], 
              Detrend[Mean[sepQ]\/\(Mean[sepQ] + findQ\), smooth]}], {1, x}, 
          x]];\)\), "\[IndentingNewLine]", 
    \(\(Print[
        Regress[Transpose[{Detrend[UrateQ, smooth], 
              Detrend[sepQ\/\(sepQ + Mean[findQ]\), smooth]}], {1, x}, 
          x]];\)\)}], "Input"],

