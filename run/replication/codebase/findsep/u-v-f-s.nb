Cell[CellGroupData[{

Cell["\<\
Construct the hypothetical unemployment rate with changes only in vacancies\
\>", "Subsubsection"],

Cell[BoxData[{
    \(t = 1; 
    hyp = h /. Solve[\((1 - h)\) Mean[SepM] \[Equal] 
            0.017\ \(h\^0.5\) HelpM[\([\)\(t\)\(]\)]\^0.5, h];\), "\n", 
    \(\(While[t < Length[HelpM], t += 1; 
        hyp = Append[hyp, 
            Last[hyp] + \((1 - Last[hyp])\) Mean[SepM] - 
              0.017\ \(Last[hyp]\^0.5\) 
                HelpM[\([\)\(t\)\(]\)]\^0.5]];\)\), "\n", 
    \(\(hypQ = 
        1\/3\ Plus @@ 
            Transpose[Partition[hyp, 3]];\)\), "\[IndentingNewLine]", 
    \(\(Export["\<hyp.dat\>", dateQ[hypQ]];\)\), "\[IndentingNewLine]", 
    \(\(Export["\<hypt.dat\>", 
        dateQ[Trend[hypQ, smooth]]];\)\), "\[IndentingNewLine]", 
    \(\(Export["\<hypd.dat\>", 
        dateQ[Detrend[hypQ, smooth]]];\)\), "\[IndentingNewLine]", 
    \(\(Export["\<uratet.dat\>", 
        dateQ[Trend[N[UrateQ], smooth]]];\)\), "\[IndentingNewLine]", 
    \(\(Export["\<urated.dat\>", 
        dateQ[Detrend[N[UrateQ], smooth]]];\)\)}], "Input"]
}, Open  ]]
},
