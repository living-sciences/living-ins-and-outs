              "Total"}, {"DF", "SumOfSq", "MeanSq", "FRatio", 
              "PValue"}}]]}]}], "}"}]], "Print"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Do the same, dropping the earlier time period.", "Subsubsection"],

Cell[CellGroupData[{

Cell[BoxData[{
    \(z = 140; Print[start + z\/4 - 1];\), "\n", 
    \(\(Print[
        Regress[Drop[
            Transpose[{Detrend[UrateQ, smooth], 
                Detrend[Mean[sepQ]\/\(Mean[sepQ] + findQ\), smooth]}], 
            z], {1, x}, x]];\)\), "\n", 
    \(\(Print[
        Regress[Drop[
            Transpose[{Detrend[UrateQ, smooth], 
                Detrend[sepQ\/\(sepQ + Mean[findQ]\), smooth]}], z], {1, x}, 
          x]];\)\)}], "Input"],

Cell[BoxData[
    \(1985\)], "Print"],

